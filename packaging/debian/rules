#!/usr/bin/make -f
# Install straight into the one binary package.
export PYBUILD_DESTDIR=debian/smart-dnd
# The test suite runs in CI; under pybuild it would need the full GTK/EDS stack.
export PYBUILD_DISABLE=test

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	install -Dm644 data/com.keithvassallo.SmartDnd.desktop debian/smart-dnd/usr/share/applications/com.keithvassallo.SmartDnd.desktop
	install -Dm644 data/com.keithvassallo.SmartDnd.metainfo.xml debian/smart-dnd/usr/share/metainfo/com.keithvassallo.SmartDnd.metainfo.xml
	# Start at login for every user; each user can switch it off in the GUI.
	install -Dm644 data/smart-dnd-autostart.desktop debian/smart-dnd/etc/xdg/autostart/com.keithvassallo.SmartDnd.desktop
	install -Dm644 data/icons/hicolor/scalable/apps/com.keithvassallo.SmartDnd.svg debian/smart-dnd/usr/share/icons/hicolor/scalable/apps/com.keithvassallo.SmartDnd.svg
	install -Dm644 data/icons/hicolor/symbolic/apps/com.keithvassallo.SmartDnd-symbolic.svg debian/smart-dnd/usr/share/icons/hicolor/symbolic/apps/com.keithvassallo.SmartDnd-symbolic.svg
